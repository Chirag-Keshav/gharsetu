{
  "name": "@propcare/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "jest --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "node ../../scripts/with-env.mjs prisma migrate deploy && prisma generate",
    "db:reset": "node ../../scripts/with-env.mjs prisma migrate reset --force --skip-seed && prisma generate && node ../../scripts/with-env.mjs tsx prisma/seed.ts",
    "db:seed": "node ../../scripts/with-env.mjs tsx prisma/seed.ts",
    "seed:admin": "node ../../scripts/with-env.mjs tsx scripts/seed-admin.ts",
    "ai:eval": "node ../../scripts/with-env.mjs jest -c jest.eval.config.js --runInBand",
    "openapi": "node ../../scripts/with-env.mjs tsx scripts/openapi.ts",
    "db:migrate:test": "node ../../scripts/with-env.mjs --test-db prisma migrate deploy"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.3",
    "@propcare/shared": "workspace:*",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "ioredis": "5.11.1",
    "pdfkit": "0.20.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.6",
    "@types/supertest": "7.2.1",
    "fast-check": "4.10.2",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15"
  }
}
