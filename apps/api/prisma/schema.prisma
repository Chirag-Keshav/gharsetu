  createdBy      String?          @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  request        ServiceRequest   @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@map("inspections")
}

model Quote {
  id                 String        @id @default(uuid(7)) @db.Uuid
  reference          String        @unique
  requestId          String        @map("request_id") @db.Uuid
  quoteType          QuoteType     @default(ORIGINAL) @map("quote_type")
  workOrderId        String?       @map("work_order_id") @db.Uuid
  baseQuoteId        String?       @map("base_quote_id") @db.Uuid
  version            Int
  status             QuoteStatus   @default(DRAFT)
  currency           String        @default("INR")
  subtotalPaise      BigInt        @default(0) @map("subtotal_paise")
  taxPaise           BigInt        @default(0) @map("tax_paise")
  totalPaise         BigInt        @default(0) @map("total_paise")
  scope              String?
  exclusions         Json          @default("[]")
  assumptions        Json          @default("[]")
  estimatedDuration  String?       @map("estimated_duration")
  validUntil         DateTime      @map("valid_until") @db.Timestamptz(3)
  sentAt             DateTime?     @map("sent_at") @db.Timestamptz(3)
  sentBy             String?       @map("sent_by") @db.Uuid
  approvedBy         String?       @map("approved_by") @db.Uuid
  approvedAt         DateTime?     @map("approved_at") @db.Timestamptz(3)
  approvedTotalPaise BigInt?       @map("approved_total_paise")
