// ------------------------------------------------------------------------------------------------
// Notifications, outbox, audit, alerts
// ------------------------------------------------------------------------------------------------
model Notification {
  id            String              @id @default(uuid(7)) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  channel       NotificationChannel
  templateKey   String              @map("template_key")
  params        Json                @default("{}")
  status        NotificationStatus  @default(PENDING)
  providerRef   String?             @map("provider_ref")
  attempts      Int                 @default(0)
  nextAttemptAt DateTime?           @map("next_attempt_at") @db.Timestamptz(3)
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(3)
  readAt        DateTime?           @map("read_at") @db.Timestamptz(3)
  failureReason String?             @map("failure_reason")
  outboxEventId String?             @map("outbox_event_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User                @relation(fields: [userId], references: [id])

  @@unique([outboxEventId, userId, channel, templateKey])
  @@index([userId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("notifications")
}

model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  type          String
  payload       Json
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz(3)
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([dispatchedAt, nextAttemptAt])
  @@map("outbox_events")
}

model StatusEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String   @map("actor_role")
  reason     String?
  ownerVisible Boolean @default(true) @map("owner_visible")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@map("status_events")
}

model AuditEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorRole      String   @map("actor_role")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  onBehalfOfType String?  @map("on_behalf_of_type")
  onBehalfOfId   String?  @map("on_behalf_of_id")
  metadata       Json     @default("{}")
  ipHash         String?  @map("ip_hash")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_events")
}

model AdminAlert {
  id         String    @id @default(uuid(7)) @db.Uuid
  type       String
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id")
  metadata   Json      @default("{}")
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedBy String?   @map("resolved_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([resolvedAt])
  @@map("admin_alerts")
}

// ------------------------------------------------------------------------------------------------
// AI
// ------------------------------------------------------------------------------------------------
model AiSuggestion {
  id            String             @id @default(uuid(7)) @db.Uuid
  featureKey    String             @map("feature_key")
  subjectType   String?            @map("subject_type")
  subjectId     String?            @map("subject_id") @db.Uuid
  audienceRole  Role               @map("audience_role")
  requestedBy   String?            @map("requested_by") @db.Uuid
  status        AiSuggestionStatus @default(PENDING)
  model         String?
  promptVersion String?            @map("prompt_version")
  inputHash     String             @map("input_hash")
  output        Json?
  errorCode     String?            @map("error_code")
  latencyMs     Int?               @map("latency_ms")
  inputTokens   Int?               @map("input_tokens")
  outputTokens  Int?               @map("output_tokens")
  actedBy       String?            @map("acted_by") @db.Uuid
  actedAt       DateTime?          @map("acted_at") @db.Timestamptz(3)
  feedback      String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subjectType, subjectId])
  @@index([featureKey, inputHash])
  @@map("ai_suggestions")
}

model AiUsage {
  usageDate    DateTime @map("usage_date") @db.Date
  userId       String   @map("user_id") @db.Uuid
  featureKey   String   @map("feature_key")
  calls        Int      @default(0)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")

  @@id([usageDate, userId, featureKey])
  @@map("ai_usage")
}
