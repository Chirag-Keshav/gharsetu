// ------------------------------------------------------------------------------------------------
// Maintenance
// ------------------------------------------------------------------------------------------------
model ServiceRequest {
  id                String        @id @default(uuid(7)) @db.Uuid
  reference         String        @unique
  ownerUserId       String        @map("owner_user_id") @db.Uuid
  propertyId        String        @map("property_id") @db.Uuid
  categoryId        String        @map("category_id") @db.Uuid
  title             String
  description       String
  intakeAnswers     Json          @default("{}") @map("intake_answers")
  urgency           Urgency       @default(STANDARD)
  safetyFlag        Boolean       @default(false) @map("safety_flag")
  safetyGuidanceKeys String[]     @default([]) @map("safety_guidance_keys")
  status            RequestStatus
  preferredWindows  Json          @default("[]") @map("preferred_windows")
  accessContactId   String?       @map("access_contact_id") @db.Uuid
  handledByAdminId  String?       @map("handled_by_admin_id") @db.Uuid
  createdOnBehalfBy String?       @map("created_on_behalf_by") @db.Uuid
  source            RequestSource @default(OWNER)
  overrideReason    String?       @map("override_reason")
  bookingId         String?       @map("booking_id") @db.Uuid
  submittedAt       DateTime      @default(now()) @map("submitted_at") @db.Timestamptz(3)
  firstResponseAt   DateTime?     @map("first_response_at") @db.Timestamptz(3)
  closedAt          DateTime?     @map("closed_at") @db.Timestamptz(3)
