// ------------------------------------------------------------------------------------------------
// Money
// ------------------------------------------------------------------------------------------------
model Payment {
  id                String              @id @default(uuid(7)) @db.Uuid
  requirementId     String?             @map("requirement_id") @db.Uuid
  bookingId         String?             @map("booking_id") @db.Uuid
  payerUserId       String              @map("payer_user_id") @db.Uuid
  provider          String
  providerPaymentId String              @map("provider_payment_id")
  amountPaise       BigInt              @map("amount_paise")
  refundedPaise     BigInt              @default(0) @map("refunded_paise")
  currency          String              @default("INR")
  status            PaymentStatus       @default(PENDING)
  checkoutUrl       String?             @map("checkout_url")
  failureReason     String?             @map("failure_reason")
  paidAt            DateTime?           @map("paid_at") @db.Timestamptz(3)
  idempotencyKey    String?             @map("idempotency_key")
  recordedBy        String?             @map("recorded_by") @db.Uuid
  offlineReason     String?             @map("offline_reason")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  requirement       PaymentRequirement? @relation(fields: [requirementId], references: [id])
  booking           Booking?            @relation(fields: [bookingId], references: [id])
  refunds           Refund[]

  @@unique([provider, providerPaymentId])
  @@index([bookingId])
  @@index([requirementId])
  @@index([payerUserId])
  @@map("payments")
}

model PaymentEvent {
  id                String    @id @default(uuid(7)) @db.Uuid
  provider          String
  providerEventId   String    @map("provider_event_id")
  eventType         String    @map("event_type")
  providerPaymentId String?   @map("provider_payment_id")
  payloadHash       String    @map("payload_hash")
  receivedAt        DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(3)
  processingNote    String?   @map("processing_note")

  @@unique([provider, providerEventId])
  @@map("payment_events")
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  amountPaise      BigInt       @map("amount_paise")
