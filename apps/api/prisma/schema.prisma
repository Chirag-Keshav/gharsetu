// ------------------------------------------------------------------------------------------------
// Messages, attachments, issues
// ------------------------------------------------------------------------------------------------
model Message {
  id           String            @id @default(uuid(7)) @db.Uuid
  threadType   ThreadType        @map("thread_type")
  threadId     String            @map("thread_id") @db.Uuid
  authorUserId String?           @map("author_user_id") @db.Uuid
