  requestId             String          @map("request_id") @db.Uuid
  propertyId            String          @map("property_id") @db.Uuid
  ownerUserId           String          @map("owner_user_id") @db.Uuid
  quoteId               String?         @unique @map("quote_id") @db.Uuid
  parentWorkOrderId     String?         @map("parent_work_order_id") @db.Uuid
  issueId               String?         @map("issue_id") @db.Uuid
  status                WorkOrderStatus @default(DRAFT)
  scheduledStart        DateTime?       @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd          DateTime?       @map("scheduled_end") @db.Timestamptz(3)
  startedAt             DateTime?       @map("started_at") @db.Timestamptz(3)
  submittedAt           DateTime?       @map("submitted_at") @db.Timestamptz(3)
  submittedBy           String?         @map("submitted_by") @db.Uuid
  completedAt           DateTime?       @map("completed_at") @db.Timestamptz(3)
  ownerReviewDueAt      DateTime?       @map("owner_review_due_at") @db.Timestamptz(3)
  approvedTotalPaise    BigInt          @default(0) @map("approved_total_paise")
  blockedReason         BlockedReason?  @map("blocked_reason")
  checklistTemplateId   String?         @map("checklist_template_id") @db.Uuid
