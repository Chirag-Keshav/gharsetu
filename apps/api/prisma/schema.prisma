// Data model (SPEC §11). Triggers, check constraints, extensions, sequences and the occupancy
// exclusion constraint live in hand-written SQL migrations (see migrations/*_constraints).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------------------------
enum Role {
  OWNER
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ServiceMode {
  CARE
  LIST
  LIST_AND_CARE
}

enum PropertyStatus {
  ACTIVE
  ARCHIVED
}

enum VerificationSubject {
  OWNER
  PROPERTY
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum DocumentOwnerType {
  VERIFICATION
  PROVIDER
}

enum ListingStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  PUBLISHED
  PAUSED
  REJECTED
  ARCHIVED
}

enum BookingMode {
  INSTANT
  OWNER_APPROVAL
}

enum OccupancyKind {
  BOOKING_HOLD
  BOOKING_CONFIRMED
  BLOCK_OWNER
  BLOCK_MAINTENANCE
  BLOCK_ADMIN
}

enum BookingStatus {
  REQUESTED
  AWAITING_PAYMENT
  CONFIRMED
  DECLINED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum PayoutStatus {
  PENDING
  ELIGIBLE
  ON_HOLD
  PAID
  VOID
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum Urgency {
  STANDARD
  URGENT
  SAFETY_RISK
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  INSPECTION_SCHEDULED
  QUOTATION_DRAFT
  QUOTATION_SENT
  APPROVED
  WORK_ORDER_CREATED
  REJECTED
  CANCELLED
  NOT_SERVICEABLE
}

enum RequestSource {
  OWNER
  ADMIN
  TURNOVER_AUTO
}

enum InspectionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_ACCESS
}

enum QuoteType {
  ORIGINAL
  CHANGE_ORDER
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  SUPERSEDED
  WITHDRAWN
  EXPIRED
}

enum LineType {
  LABOUR
  MATERIAL
  TRAVEL
  INSPECTION_FEE
  OTHER
  DISCOUNT
}

enum LineDirection {
  ADD
  DEDUCT
}

enum ProviderType {
  INDIVIDUAL
  GROUP
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProviderVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkOrderKind {
  STANDARD
  REWORK
}

enum WorkOrderStatus {
  DRAFT
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  SUBMITTED_FOR_REVIEW
  REWORK_REQUIRED
  READY_FOR_OWNER_REVIEW
  COMPLETED
  CANCELLED
}

enum BlockedReason {
  ACCESS_DENIED
  HIDDEN_DAMAGE
  MATERIAL_UNAVAILABLE
  SAFETY_CONCERN
  SCOPE_CHANGE
  OTHER
}

enum AssignmentRole {
  PRIMARY
  SUPPORT
}

enum AssignmentStatus {
  ACTIVE
  REMOVED
}

enum PaymentPurpose {
  INSPECTION_FEE
  DEPOSIT
  MILESTONE
  FINAL
}

enum DueTrigger {
  ON_INSPECTION_SCHEDULED
  ON_QUOTE_APPROVAL
  ON_WORK_SCHEDULED
  ON_COMPLETION_ACCEPTED
  MANUAL
}

enum RequirementStatus {
  PENDING
  PAID
  WAIVED
  CANCELLED
}

enum ThreadType {
  REQUEST
  ISSUE
  WORK_ORDER
  BOOKING
  LISTING_REVIEW
}

enum MessageVisibility {
  PARTICIPANT
  INTERNAL
}

enum AttachmentOwnerType {
  PROPERTY
  LISTING
  REQUEST
  MESSAGE
  INSPECTION
  WORK_ORDER
  ISSUE
  VERIFICATION
  PROVIDER
}

enum EvidencePhase {
  GENERAL
  BEFORE
  DURING
  AFTER
}

enum AttachmentStatus {
  PENDING
  AVAILABLE
  REJECTED
  DELETED
}

enum AttachmentSource {
  USER_UPLOAD
  ADMIN_UPLOAD_FOR_PROVIDER
}

enum AttachmentVisibility {
  PUBLIC
  PARTICIPANT
  INTERNAL
}

enum IssueSubjectType {
  WORK_ORDER
  BOOKING
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ResolutionCode {
  REWORK_DONE
  PARTIAL_REFUND
  FULL_REFUND
  PAYOUT_ADJUSTED
  NO_ACTION_REQUIRED
  DUPLICATE
  RAISER_WITHDREW
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum InvoiceKind {
  MAINTENANCE_RECEIPT
  MAINTENANCE_FINAL
  BOOKING_RECEIPT
  COMMISSION_STATEMENT
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AiSuggestionStatus {
  PENDING
  READY
  ACCEPTED
  EDITED
  DISMISSED
  FAILED
}

// ------------------------------------------------------------------------------------------------
// Identity
// ------------------------------------------------------------------------------------------------
model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  phoneE164          String     @unique @map("phone_e164")
  phoneVerifiedAt    DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  email              String?
  fullName           String?    @map("full_name")
  status             UserStatus @default(ACTIVE)
  permissionFlags    String[]   @default([]) @map("permission_flags")
  communicationPrefs Json       @default("{}") @map("communication_prefs")
  lastActiveRole     Role?      @map("last_active_role")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles         UserRole[]
  sessions      Session[]
  ownerProfile  OwnerProfile?
  properties    Property[]
  notifications Notification[]

  @@map("users")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, role])
  @@map("user_roles")
}

model OwnerProfile {
  userId                   String             @id @map("user_id") @db.Uuid
  defaultServiceMode       ServiceMode?       @map("default_service_mode")
  payoutAccountRef         String?            @map("payout_account_ref")
  commissionOverrideBps    Int?               @map("commission_override_bps")
  commissionOverrideReason String?            @map("commission_override_reason")
  verificationStatus       VerificationStatus @default(NOT_SUBMITTED) @map("verification_status")
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                     User               @relation(fields: [userId], references: [id])

  @@map("owner_profiles")
}

model OtpChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  phoneE164  String    @map("phone_e164")
  verifier   String
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  ipHash     String?   @map("ip_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneE164, createdAt])
  @@map("otp_challenges")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  activeRole Role?     @map("active_role")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipHash     String?   @map("ip_hash")
  userAgent  String?   @map("user_agent")
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  key            String
  userId         String   @map("user_id") @db.Uuid
  endpoint       String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, endpoint, key])
  @@map("idempotency_keys")
}

model ConsentRecord {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  documentType String   @map("document_type")
  version      String
  acceptedAt   DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("consent_records")
}

// ------------------------------------------------------------------------------------------------
// Configuration
// ------------------------------------------------------------------------------------------------
model ServiceArea {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  state       String
  district    String
  pinCodes    String[] @map("pin_codes")
  isActive    Boolean  @default(true) @map("is_active")
  offersStays Boolean  @default(false) @map("offers_stays")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories CategoryServiceArea[]
  providers  ProviderServiceArea[]

  @@map("service_areas")
}

model ServiceCategory {
  id                        String   @id @default(uuid(7)) @db.Uuid
  slug                      String   @unique
  name                      String
  description               String?
  isActive                  Boolean  @default(true) @map("is_active")
  displayOrder              Int      @default(100) @map("display_order")
  inspectionUsuallyRequired Boolean  @default(false) @map("inspection_usually_required")
  intakeSchema              Json     @map("intake_schema")
  dangerRules               Json     @default("[]") @map("danger_rules")
  safetyNotes               String?  @map("safety_notes")
  attachmentRules           Json     @default("{}") @map("attachment_rules")
  requiredEvidence          Json     @default("{}") @map("required_evidence")
  paymentPolicy             Json     @default("{}") @map("payment_policy")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceAreas       CategoryServiceArea[]
  checklistTemplates ChecklistTemplate[]
  providers          ProviderSkill[]

  @@map("service_categories")
}

model CategoryServiceArea {
  categoryId    String          @map("category_id") @db.Uuid
  serviceAreaId String          @map("service_area_id") @db.Uuid
  category      ServiceCategory @relation(fields: [categoryId], references: [id])
  serviceArea   ServiceArea     @relation(fields: [serviceAreaId], references: [id])

  @@id([categoryId, serviceAreaId])
  @@map("category_service_areas")
}

model ChecklistTemplate {
  id         String          @id @default(uuid(7)) @db.Uuid
  categoryId String          @map("category_id") @db.Uuid
  version    Int
  items      Json
  isActive   Boolean         @default(true) @map("is_active")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  category   ServiceCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, version])
  @@map("checklist_templates")
}

model Amenity {
  id        String           @id @default(uuid(7)) @db.Uuid
  slug      String           @unique
  name      String
  group     String
  iconKey   String?          @map("icon_key")
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  listings  ListingAmenity[]

  @@map("amenities")
}

model CancellationPolicy {
  key         String   @id
  name        String
  description String?
  rules       Json
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("cancellation_policies")
}

model PolicySetting {
  key         String   @id
  valueJson   Json     @map("value_json")
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("policy_settings")
}

// ------------------------------------------------------------------------------------------------
// Properties and verification
// ------------------------------------------------------------------------------------------------
model Property {
  id                 String             @id @default(uuid(7)) @db.Uuid
  ownerUserId        String             @map("owner_user_id") @db.Uuid
  nickname           String
  propertyType       String             @map("property_type")
  addressLine1       String             @map("address_line1")
  addressLine2       String?            @map("address_line2")
  locality           String
  city               String
  district           String
  state              String
  pinCode            String             @map("pin_code")
  latitude           Float?
  longitude          Float?
  areaSqft           Int?               @map("area_sqft")
  /// Encrypted at application level (AES-256-GCM); never returned by default.
  accessNotes        String?            @map("access_notes")
  serviceMode        ServiceMode        @map("service_mode")
  status             PropertyStatus     @default(ACTIVE)
  verificationStatus VerificationStatus @default(NOT_SUBMITTED) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner    User              @relation(fields: [ownerUserId], references: [id])
  contacts PropertyContact[]
  listing  Listing?
  requests ServiceRequest[]

  @@index([ownerUserId])
  @@map("properties")
}

model PropertyContact {
  id               String    @id @default(uuid(7)) @db.Uuid
  propertyId       String    @map("property_id") @db.Uuid
  name             String
  phone            String
  relationship     String
  accessRole       String?   @map("access_role")
  consentConfirmed Boolean   @map("consent_confirmed")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  property         Property  @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
  @@map("property_contacts")
}

model Verification {
  id          String              @id @default(uuid(7)) @db.Uuid
  subjectType VerificationSubject @map("subject_type")
  subjectId   String              @map("subject_id") @db.Uuid
  status      VerificationStatus
  submittedAt DateTime?           @map("submitted_at") @db.Timestamptz(3)
  reviewedBy  String?             @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  reason      String?
  expiresAt   DateTime?           @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([subjectType, subjectId])
  @@index([status])
  @@map("verifications")
}

model VerificationDocument {
  id           String            @id @default(uuid(7)) @db.Uuid
  ownerType    DocumentOwnerType @map("owner_type")
  ownerId      String            @map("owner_id") @db.Uuid
  docType      String            @map("doc_type")
  attachmentId String            @map("attachment_id") @db.Uuid
  objectKey    String            @map("object_key")
  status       String            @default("ACTIVE")
  expiresAt    DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerType, ownerId])
  @@map("verification_documents")
}

// ------------------------------------------------------------------------------------------------
// Listings, occupancy, bookings
// ------------------------------------------------------------------------------------------------
model Listing {
  id                      String        @id @default(uuid(7)) @db.Uuid
  reference               String        @unique
  propertyId              String        @unique @map("property_id") @db.Uuid
  ownerUserId             String        @map("owner_user_id") @db.Uuid
  status                  ListingStatus @default(DRAFT)
  title                   String        @default("")
  description             String        @default("")
  maxGuests               Int           @default(2) @map("max_guests")
  bedrooms                Int           @default(1)
  beds                    Int           @default(1)
  bathrooms               Int           @default(1)
  houseRules              Json          @default("{}") @map("house_rules")
  checkInTime             String        @default("14:00") @map("check_in_time")
  checkOutTime            String        @default("11:00") @map("check_out_time")
  basePricePaise          BigInt        @default(0) @map("base_price_paise")
  weekendPricePaise       BigInt?       @map("weekend_price_paise")
  cleaningFeePaise        BigInt        @default(0) @map("cleaning_fee_paise")
  minNights               Int           @default(1) @map("min_nights")
  maxNights               Int           @default(30) @map("max_nights")
  advanceNoticeHours      Int           @default(24) @map("advance_notice_hours")
  maxAdvanceDays          Int           @default(365) @map("max_advance_days")
  bookingMode             BookingMode   @default(INSTANT) @map("booking_mode")
  cancellationPolicyKey   String?       @map("cancellation_policy_key")
  turnoverCleaningEnabled Boolean       @default(false) @map("turnover_cleaning_enabled")
  publicAreaLabel         String        @default("") @map("public_area_label")
  approxLatitude          Float?        @map("approx_latitude")
  approxLongitude         Float?        @map("approx_longitude")
  /// Door/access instructions for guests; disclosed only per SPEC §7 rule 18.
  checkinInstructions     String?       @map("checkin_instructions")
  searchVector            Unsupported("tsvector")? @map("search_vector")
  ratingAvg               Float?        @map("rating_avg")
  ratingCount             Int           @default(0) @map("rating_count")
  publishedAt             DateTime?     @map("published_at") @db.Timestamptz(3)
  submittedAt             DateTime?     @map("submitted_at") @db.Timestamptz(3)
  pausedBy                Role?         @map("paused_by")
  editedSinceReview       Boolean       @default(false) @map("edited_since_review")
  reviewedBy              String?       @map("reviewed_by") @db.Uuid
  reviewedAt              DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  property   Property           @relation(fields: [propertyId], references: [id])
  amenities  ListingAmenity[]
  photos     ListingPhoto[]
  priceRules ListingPriceRule[]
  occupancy  ListingOccupancy[]
  bookings   Booking[]
  reviews    Review[]

  @@index([status])
  @@index([ownerUserId])
  @@map("listings")
}

model ListingAmenity {
  listingId String  @map("listing_id") @db.Uuid
  amenityId String  @map("amenity_id") @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  @@id([listingId, amenityId])
  @@map("listing_amenities")
}

model ListingPhoto {
  id             String     @id @default(uuid(7)) @db.Uuid
  listingId      String     @map("listing_id") @db.Uuid
  attachmentId   String     @map("attachment_id") @db.Uuid
  position       Int
  caption        String?
  isCover        Boolean    @default(false) @map("is_cover")
  publicVariants Json?      @map("public_variants")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  listing        Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  attachment     Attachment @relation(fields: [attachmentId], references: [id])

  @@index([listingId])
  @@map("listing_photos")
}

model ListingPriceRule {
  id                String   @id @default(uuid(7)) @db.Uuid
  listingId         String   @map("listing_id") @db.Uuid
  startDate         DateTime @map("start_date") @db.Date
  /// Inclusive.
  endDate           DateTime @map("end_date") @db.Date
  nightlyPricePaise BigInt   @map("nightly_price_paise")
  reason            String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  listing           Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_price_rules")
}

/// Nights [start_date, end_date) — an exclusion constraint makes overlaps impossible.
model ListingOccupancy {
  id          String        @id @default(uuid(7)) @db.Uuid
  listingId   String        @map("listing_id") @db.Uuid
  startDate   DateTime      @map("start_date") @db.Date
  endDate     DateTime      @map("end_date") @db.Date
  kind        OccupancyKind
  bookingId   String?       @map("booking_id") @db.Uuid
  workOrderId String?       @map("work_order_id") @db.Uuid
  /// Exact window for maintenance blocks (used for check-out-day overlap checks).
  startsAt    DateTime?     @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime?     @map("ends_at") @db.Timestamptz(3)
  expiresAt   DateTime?     @map("expires_at") @db.Timestamptz(3)
  note        String?
  createdBy   String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  listing     Listing       @relation(fields: [listingId], references: [id])

  @@index([listingId, startDate])
  @@index([bookingId])
  @@index([workOrderId])
  @@map("listing_occupancy")
}

model Booking {
  id                          String        @id @default(uuid(7)) @db.Uuid
  reference                   String        @unique
  listingId                   String        @map("listing_id") @db.Uuid
  customerUserId              String        @map("customer_user_id") @db.Uuid
  ownerUserId                 String        @map("owner_user_id") @db.Uuid
  status                      BookingStatus
  checkInDate                 DateTime      @map("check_in_date") @db.Date
  checkOutDate                DateTime      @map("check_out_date") @db.Date
  checkInAt                   DateTime      @map("check_in_at") @db.Timestamptz(3)
  checkOutAt                  DateTime      @map("check_out_at") @db.Timestamptz(3)
  nights                      Int
  guestsCount                 Int           @map("guests_count")
  specialRequests             String?       @map("special_requests")
  guestDetails                Json?         @map("guest_details")
  bookingModeSnapshot         BookingMode   @map("booking_mode_snapshot")
  cancellationPolicySnapshot  Json          @map("cancellation_policy_snapshot")
  pricingSnapshot             Json          @map("pricing_snapshot")
  nightsTotalPaise            BigInt        @map("nights_total_paise")
  cleaningFeePaise            BigInt        @map("cleaning_fee_paise")
  taxPaise                    BigInt        @map("tax_paise")
  totalPaise                  BigInt        @map("total_paise")
  commissionBpsApplied        Int           @map("commission_bps_applied")
  commissionBenchmarkSnapshot Json          @map("commission_benchmark_snapshot")
  commissionPaise             BigInt        @map("commission_paise")
  ownerPayoutPaise            BigInt        @map("owner_payout_paise")
  holdExpiresAt               DateTime?     @map("hold_expires_at") @db.Timestamptz(3)
  requestExpiresAt            DateTime?     @map("request_expires_at") @db.Timestamptz(3)
  requestedAt                 DateTime      @default(now()) @map("requested_at") @db.Timestamptz(3)
  confirmedAt                 DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt                 DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledByRole             String?       @map("cancelled_by_role")
  cancelReason                String?       @map("cancel_reason")
  refundPaise                 BigInt        @default(0) @map("refund_paise")
  completedAt                 DateTime?     @map("completed_at") @db.Timestamptz(3)
  createdAt                   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  listing  Listing   @relation(fields: [listingId], references: [id])
  payments Payment[]
  payout   Payout?
  review   Review?

  @@index([customerUserId])
  @@index([ownerUserId])
  @@index([listingId])
  @@index([status])
  @@map("bookings")
}

